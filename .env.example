# Bot Core
BOT_CORE_APP_NAME=bot-core
BOT_CORE_APP_VERSION=0.2.0
BOT_CORE_URL=http://bot-core:8000
# Сколько адаптеры VK/MAX ждут ответа bot-core (должно быть больше DIFY_TIMEOUT_SECONDS)
BOT_CORE_TIMEOUT_SECONDS=300

# Токены ботов
VK_BOT_TOKEN=
MAX_BOT_TOKEN=
# Адрес MAX Bot API (по умолчанию https://platform-api.max.ru)
# MAX_API_URL=https://platform-api.max.ru

# Dify (приложение Chatflow)
# Базовый URL Service API, вместе с /v1. Если Dify на этом же сервере в своём compose:
# DIFY_API_URL=http://host.docker.internal/v1
DIFY_API_URL=https://dify.example.ru/v1
# API-ключ приложения: Dify → приложение → «Доступ к API» (app-...)
DIFY_API_KEY=
# Сколько bot-core ждёт ответ Dify (blocking-режим)
DIFY_TIMEOUT_SECONDS=280
# Поле метаданных документов базы знаний Dify со ссылкой на источник (для кнопок «Подробнее»)
DIFY_SOURCE_URL_FIELD=url

# База витрины: пользователи, conversation_id в Dify, оценки
POSTGRES_DB=voproshalych
POSTGRES_USER=voproshalych
POSTGRES_PASSWORD=voproshalych
